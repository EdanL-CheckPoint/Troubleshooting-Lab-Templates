    },
    "AppEpSubnetDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "AppVPCGatewayAttachment",
      "Properties": {
        "RouteTableId": { "Ref": "AppEpSubnetRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "AppIGW" }
      }
    },
    "AppEpSubnetRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "AppEpSubnet" },
        "RouteTableId": { "Ref": "AppEpSubnetRouteTable" }
      }
    },
    "WebInstanceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Allow HTTP, HTTPS and SSH to the web instance",
        "VpcId": { "Ref": "WebVPC" },
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "CidrIp": "0.0.0.0/0", "Description": "HTTP" },
          { "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0", "Description": "HTTPS" },
          { "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": "0.0.0.0/0", "Description": "SSH" }
        ],
        "Tags": [ { "Key": "Name", "Value": "web-instance-sg" } ]
      }
    },
    "WebInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": { "Ref": "ApacheAMI" },
        "InstanceType": { "Ref": "ApacheInstanceType" },
        "KeyName": { "Ref": "KeyName" },
        "SubnetId": { "Ref": "WebSubnet" },
        "PrivateIpAddress": "10.10.0.50",
        "SecurityGroupIds": [ { "Ref": "WebInstanceSecurityGroup" } ],
        "Tags": [ { "Key": "Name", "Value": "web-instance" } ]
      }
    },
    "WebInstanceEIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [ { "Key": "Name", "Value": "web-instance-eip" } ]
      }
    },
    "WebInstanceEIPAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "DependsOn": "WebVPCGatewayAttachment",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": [ "WebInstanceEIP", "AllocationId" ] },
        "InstanceId": { "Ref": "WebInstance" }
      }
    },
    "AppInstanceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Allow HTTP, HTTPS and SSH to the app instance",
        "VpcId": { "Ref": "AppVPC" },
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "CidrIp": "0.0.0.0/0", "Description": "HTTP" },
          { "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0", "Description": "HTTPS" },
          { "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": "0.0.0.0/0", "Description": "SSH" }
        ],
        "Tags": [ { "Key": "Name", "Value": "app-instance-sg" } ]
      }
    },
    "AppInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": { "Ref": "ApacheAMI" },
        "InstanceType": { "Ref": "ApacheInstanceType" },
        "KeyName": { "Ref": "KeyName" },
        "SubnetId": { "Ref": "AppSubnet" },
        "PrivateIpAddress": "10.20.0.50",
        "SecurityGroupIds": [ { "Ref": "AppInstanceSecurityGroup" } ],
        "Tags": [ { "Key": "Name", "Value": "app-instance" } ]
      }
    },
    "AppInstanceEIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [ { "Key": "Name", "Value": "app-instance-eip" } ]
      }
    },
    "AppInstanceEIPAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "DependsOn": "AppVPCGatewayAttachment",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": [ "AppInstanceEIP", "AllocationId" ] },
        "InstanceId": { "Ref": "AppInstance" }
      }
    }
  },
  "Outputs": {
    "VPCID": {
      "Description": "VPC ID.",
      "Value": { "Fn::GetAtt": [ "VPCStack", "Outputs.VPCID" ] }
    },
    "ManagementPublicAddress": {
      "Description": "The public address of the management server.",
      "Value": { "Fn::GetAtt": [ "GWLBStack", "Outputs.ManagementPublicAddress" ] },
      "Condition": "DeployManagement"
    },
    "ConfigurationTemplateName": {
      "Description": "The name that represents the configuration template. Configurations required to automatically provision the Gateways in the Auto Scaling Group, such as what Security Policy to install and which Blades to enable, will be placed under this template name.",
      "Value": { "Fn::GetAtt": [ "GWLBStack", "Outputs.ConfigurationTemplateName" ] }
    },
    "ControllerName": {
      "Description": "The name that represents the controller. Configurations required to connect to your AWS environment, such as credentials and regions, will be placed under this controller name",
      "Value": { "Fn::GetAtt": [ "GWLBStack", "Outputs.ControllerName" ] }
    },
    "GWLBName": {
      "Description": "Gateway Load Balancer Name.",
      "Value": { "Ref": "GWLBName" }
    },
    "GWLBServiceName": {
      "Description": "Gateway Load Balancer Service Name.",
      "Value": { "Fn::GetAtt": [ "GWLBStack", "Outputs.GWLBServiceName" ] }
    }
  },
  "Rules": {
    "GatewayAddressAllocationRule": {
      "RuleCondition": {
        "Fn::Equals": [
          { "Ref": "ControlGatewayOverPrivateOrPublicAddress" },
          "public"
        ]
      },
      "Assertions": [
        {
          "AssertDescription": "Gateway's selected to be provisioned by public IP, but ['AllocatePublicAddress'] parameter is false",
          "Assert": {
            "Fn::Equals": [
              { "Ref": "AllocatePublicAddress" },
              "true"
            ]
          }
        }
      ]
    }
  }
}
